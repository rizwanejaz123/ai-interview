# Server-side only. The browser talks to Next.js route handlers, not this URL.
# Local: http://127.0.0.1:8080
# Staging: https://dev.netpace.ai/ventiq/vetting
VETTING_API_URL=https://dev.netpace.ai/ventiq/vetting

# Server-side only. Must match the vetting API ADMIN_TOKEN. Never expose this to the client.
ADMIN_TOKEN=dev-admin-token

# Temporary hardcoded admin UI login (defaults: admin / admin).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
ADMIN_SESSION_SECRET=dev-admin-session
